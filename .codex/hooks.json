{
  "description": "Advise after Codex edits an NL artifact; malformed input is fail-open.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/check-artifact.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}\\scripts\\check-artifact.py\"",
            "timeout": 5,
            "statusMessage": "Checking edited NL artifacts"
          }
        ]
      }
    ]
  }
}

